# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/maaadagency

# ─── Auth (generate with: openssl rand -hex 32) ──────────────────────────────
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Seed bootstrap admin ────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@maaadagency.com
SEED_ADMIN_PASSWORD=change-me-before-production
SEED_EMPLOYEE_PASSWORD=change-me-before-production

# ─── WhatsApp Business Cloud API ─────────────────────────────────────────────
# Never commit real values. Provision these from Meta Business Manager.
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# When true, outbound messages are logged instead of sent (safe local development)
WHATSAPP_DRY_RUN=true

# ─── Uploads ─────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15
